generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id         String     @id @default(uuid())
  name       String
  email      String     @unique
  password   String
  role       Role       @default(ADMIN)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")
  properties Property[]
  projects   Project[]

  @@map("users")
}

model Category {
  id         String     @id @default(uuid())
  name       String     @unique
  slug       String     @unique
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")
  properties Property[]
  projects   Project[]

  @@map("categories")
}

model Country {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  states    State[]

  @@map("countries")
}

model State {
  id        String    @id @default(uuid())
  name      String
  slug      String
  countryId String    @map("country_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  cities    City[]
  country   Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, name])
  @@unique([countryId, slug])
  @@index([countryId])
  @@map("states")
}

model City {
  id         String     @id @default(uuid())
  name       String
  slug       String
  stateId    String     @map("state_id")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")
  state      State      @relation(fields: [stateId], references: [id], onDelete: Cascade)
  properties Property[]
  projects   Project[]

  @@unique([stateId, name])
  @@unique([stateId, slug])
  @@index([stateId])
  @@map("cities")
}

model PropertyStatus {
  id         String     @id @default(uuid())
  name       String     @unique
  colorClass String     @default("bg-green-100 text-green-800") @map("color_class")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")
  properties Property[]

  @@map("property_statuses")
}

model PropertyPurpose {
  id         String     @id @default(uuid())
  name       String     @unique
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")
  properties Property[]

  @@map("property_purposes")
}

model Property {
  id              String          @id @default(uuid())
  title           String
  slug            String          @unique
  description     String          @db.Text
  price           Decimal         @db.Decimal(12, 2)
  address         String
  bedrooms        Int             @default(0)
  bathrooms       Int             @default(0)
  areaSize        Int             @map("area_size")
  isFeatured      Boolean         @default(false) @map("is_featured")
  contactNumber   String?         @map("contact_number")
  categoryId      String          @map("category_id")
  statusId        String          @map("status_id")
  purposeId       String          @map("purpose_id")
  cityId          String          @map("city_id")
  createdById     String          @map("created_by_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  metaDescription String?         @map("meta_description") @db.Text
  metaTitle       String?         @map("meta_title")
  amenities       String?         @db.LongText
  builder_address String?
  builder_name    String?
  builder_phone   String?
  facing          String?
  is_corner       Boolean         @default(false)
  projectId       String?         @map("project_id")
  propertyCode    String?         @map("property_code")
  unitType        String          @default("1 BHK") @map("unit_type")
  enquiries       Enquiry[]
  category        Category        @relation(fields: [categoryId], references: [id])
  city            City            @relation(fields: [cityId], references: [id])
  createdBy       User            @relation(fields: [createdById], references: [id])
  purpose         PropertyPurpose @relation(fields: [purposeId], references: [id])
  status          PropertyStatus  @relation(fields: [statusId], references: [id])
  images          PropertyImage[]
  project         Project?        @relation(fields: [projectId], references: [id])
  specifications  PropertySpecification[]

  @@index([categoryId])
  @@index([statusId])
  @@index([purposeId])
  @@index([cityId])
  @@index([createdById])
  @@index([projectId])
  @@index([price])
  @@index([isFeatured])
  @@index([createdAt])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(uuid())
  url        String   @db.Text
  publicId   String?  @map("public_id")
  isFeatured Boolean  @default(false) @map("is_featured")
  sortOrder  Int      @default(0) @map("sort_order")
  propertyId String   @map("property_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([sortOrder])
  @@map("property_images")
}

model Enquiry {
  id         String        @id @default(uuid())
  name       String
  email      String
  phone      String
  message    String        @db.Text
  status     EnquiryStatus @default(NEW)
  propertyId String?       @map("property_id")
  projectId  String?       @map("project_id")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  deletedAt  DateTime?     @map("deleted_at")
  notes      String?       @db.Text
  property   Property?     @relation(fields: [propertyId], references: [id])
  project    Project?      @relation(fields: [projectId], references: [id])

  @@index([propertyId])
  @@index([projectId])
  @@index([status])
  @@map("enquiries")
}

model SeoSetting {
  id              String   @id @default(uuid())
  pageType        PageType @map("page_type")
  entityId        String?  @map("entity_id")
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description") @db.Text
  metaKeywords    String?  @map("meta_keywords") @db.Text
  ogTitle         String?  @map("og_title")
  ogDescription   String?  @map("og_description") @db.Text
  ogImage         String?  @map("og_image") @db.Text
  canonicalUrl    String?  @map("canonical_url") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([pageType, entityId])
  @@map("seo_settings")
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

enum EnquiryStatus {
  NEW
  CONTACTED
  NEGOTIATION
  CLOSED
  CONVERTED
  RESOLVED
}

enum PageType {
  HOME
  PROPERTY_LISTING
  PROPERTY
  CONTACT
  ABOUT
  PRIVACY_POLICY
  TERMS
  FAQ
}

enum ProjectStatus {
  ONGOING
  COMPLETED
  UPCOMING
}

model Project {
  id               String          @id @default(uuid())
  projectName      String          @map("project_name")
  slug             String          @unique
  address          String          @db.Text
  description      String          @db.Text
  shortDescription String?         @map("short_description") @db.Text
  builderName      String          @map("builder_name")
  builderPhone     String          @map("builder_phone")
  builderEmail     String          @map("builder_email")
  status           ProjectStatus   @default(ONGOING)
  bannerImage      String?         @map("banner_image") @db.Text
  mainImage        String?         @map("main_image") @db.Text
  brochureFile     String?         @map("brochure_file") @db.Text
  googleMapIframe  String?         @map("google_map_iframe") @db.Text
  isFeatured       Boolean         @default(false) @map("is_featured")
  displayOrder     Int             @default(0) @map("display_order")
  categoryId       String          @map("category_id")
  createdById      String          @map("created_by_id")
  cityId           String          @map("city_id")
  metaTitle        String?         @map("meta_title")
  metaDescription  String?         @map("meta_description") @db.Text
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  deletedAt        DateTime?       @map("deleted_at")

  category         Category        @relation(fields: [categoryId], references: [id])
  createdBy        User            @relation(fields: [createdById], references: [id])
  city             City            @relation(fields: [cityId], references: [id])
  images           ProjectImage[]
  amenities        ProjectAmenity[]
  specifications   ProjectSpecification[]
  highlights       ProjectHighlight[]
  properties       Property[]
  enquiries        Enquiry[]

  @@index([categoryId])
  @@index([createdById])
  @@index([cityId])
  @@index([createdAt])
  @@map("projects")
}

model ProjectImage {
  id         String   @id @default(uuid())
  url        String   @db.Text
  publicId   String?  @map("public_id")
  isFeatured Boolean  @default(false) @map("is_featured")
  sortOrder  Int      @default(0) @map("sort_order")
  projectId  String   @map("project_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([sortOrder])
  @@map("project_images")
}

model ProjectAmenity {
  id        String   @id @default(uuid())
  name      String
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_amenities")
}

model ProjectSpecification {
  id        String   @id @default(uuid())
  title     String
  value     String   @db.Text
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_specifications")
}

model ProjectHighlight {
  id        String   @id @default(uuid())
  text      String
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_highlights")
}

model PropertySpecification {
  id         String   @id @default(uuid())
  title      String
  value      String   @db.Text
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_specifications")
}

