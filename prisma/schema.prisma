datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

// User roles for system administrators
enum Role {
  ADMIN
  SUPER_ADMIN
}

// Enquiry processing stages
enum EnquiryStatus {
  NEW
  CONTACTED
  NEGOTIATION
  CLOSED
  CONVERTED
  RESOLVED
}

// Administrators with secure login credentials
model User {
  id         String     @id @default(uuid())
  name       String
  email      String     @unique
  password   String // Hashed password
  role       Role       @default(ADMIN)
  properties Property[] // Properties created/managed by this administrator
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")

  @@map("users")
}

// Property classifications (e.g., Apartment, Villa, Commercial)
model Category {
  id         String     @id @default(uuid())
  name       String     @unique
  slug       String     @unique // SEO URL lookup support
  properties Property[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")

  @@map("categories")
}

// Top level location tier (e.g., United States)
model Country {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  states    State[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("countries")
}

// Mid level location tier (e.g., New York, California)
model State {
  id        String    @id @default(uuid())
  name      String
  slug      String
  countryId String    @map("country_id")
  country   Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities    City[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([countryId, name])
  @@unique([countryId, slug])
  @@index([countryId])
  @@map("states")
}

// Bottom level location tier (e.g., Manhattan, Los Angeles)
model City {
  id         String     @id @default(uuid())
  name       String
  slug       String
  stateId    String     @map("state_id")
  state      State      @relation(fields: [stateId], references: [id], onDelete: Cascade)
  properties Property[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")

  @@unique([stateId, name])
  @@unique([stateId, slug])
  @@index([stateId])
  @@map("cities")
}

// Availability markers (e.g., Available, Sold, Under Offer)
model PropertyStatus {
  id         String     @id @default(uuid())
  name       String     @unique
  colorClass String     @default("bg-green-100 text-green-800") @map("color_class") // Tailored UI styling badge
  properties Property[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")

  @@map("property_statuses")
}

// Purpose classifications (e.g., Buy, Rent, Sell)
model PropertyPurpose {
  id         String     @id @default(uuid())
  name       String     @unique
  properties Property[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")

  @@map("property_purposes")
}

// Central Property entity
model Property {
  id            String  @id @default(uuid())
  title         String
  slug          String  @unique // SEO-friendly URL slug
  description   String  @db.Text
  price         Decimal @db.Decimal(12, 2)
  address       String
  bedrooms      Int     @default(0)
  bathrooms     Int     @default(0)
  areaSize      Int     @map("area_size") // Represented in square feet
  isFeatured    Boolean @default(false) @map("is_featured")
  contactNumber String? @map("contact_number")

  // Relations
  categoryId  String          @map("category_id")
  category    Category        @relation(fields: [categoryId], references: [id])
  statusId    String          @map("status_id")
  status      PropertyStatus  @relation(fields: [statusId], references: [id])
  purposeId   String          @map("purpose_id")
  purpose     PropertyPurpose @relation(fields: [purposeId], references: [id])
  cityId      String          @map("city_id")
  city        City            @relation(fields: [cityId], references: [id])
  createdById String          @map("created_by_id")
  createdBy   User            @relation(fields: [createdById], references: [id])

  images    PropertyImage[]
  enquiries Enquiry[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Performance Indexes for Filtering, Sorting & Search
  @@index([categoryId])
  @@index([statusId])
  @@index([purposeId])
  @@index([cityId])
  @@index([createdById])
  @@index([price])
  @@index([isFeatured])
  @@index([createdAt])
  @@map("properties")
}

// Image gallery files referencing Cloudinary resources
model PropertyImage {
  id         String   @id @default(uuid())
  url        String   @db.Text
  publicId   String?  @map("public_id") // Cloudinary resource ID for deletion tasks
  isFeatured Boolean  @default(false) @map("is_featured") // Primary card image
  sortOrder  Int      @default(0) @map("sort_order") // Gallery sorting sequence
  propertyId String   @map("property_id")
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([propertyId])
  @@index([sortOrder])
  @@map("property_images")
}

// User-submitted contact requests
model Enquiry {
  id         String        @id @default(uuid())
  name       String
  email      String
  phone      String
  message    String        @db.Text
  notes      String?       @db.Text
  status     EnquiryStatus @default(NEW)
  propertyId String        @map("property_id")
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  deletedAt  DateTime?     @map("deleted_at")

  @@index([propertyId])
  @@index([status])
  @@map("enquiries")
}
